/* BetEA Global Styles */

@tailwind base;
@tailwind components;
@tailwind utilities;

/* Import Google Fonts */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

@layer base {
  :root {
    /* BetEA Brand Colors */
    --brand-green: #00A651;
    --brand-gold: #FFB81C;
    --brand-navy: #1A1F2E;
    
    /* Functional Colors */
    --success: #06D6A0;
    --warning: #FFB81C;
    --error: #E63946;
    --info: #00B4D8;
    
    /* Semantic Colors (for shadcn/ui) */
    --background: 0 0% 100%;
    --foreground: 222 47% 11%;
    --card: 0 0% 100%;
    --card-foreground: 222 47% 11%;
    --popover: 0 0% 100%;
    --popover-foreground: 222 47% 11%;
    --primary: 151 100% 33%;
    --primary-foreground: 0 0% 100%;
    --secondary: 38 100% 55%;
    --secondary-foreground: 222 47% 11%;
    --muted: 0 0% 96%;
    --muted-foreground: 220 9% 46%;
    --accent: 38 100% 55%;
    --accent-foreground: 222 47% 11%;
    --destructive: 354 70% 54%;
    --destructive-foreground: 0 0% 100%;
    --border: 220 13% 91%;
    --input: 220 13% 91%;
    --ring: 151 100% 33%;
    --radius: 0.5rem;
  }

  .dark {
    --background: 222 47% 11%;
    --foreground: 0 0% 100%;
    --card: 222 47% 11%;
    --card-foreground: 0 0% 100%;
    --popover: 222 47% 11%;
    --popover-foreground: 0 0% 100%;
    --primary: 151 100% 33%;
    --primary-foreground: 0 0% 100%;
    --secondary: 38 100% 55%;
    --secondary-foreground: 222 47% 11%;
    --muted: 217 33% 17%;
    --muted-foreground: 220 9% 46%;
    --accent: 38 100% 55%;
    --accent-foreground: 222 47% 11%;
    --destructive: 354 70% 54%;
    --destructive-foreground: 0 0% 100%;
    --border: 217 33% 17%;
    --input: 217 33% 17%;
    --ring: 151 100% 33%;
  }
}

@layer base {
  * {
    @apply border-border;
  }
  
  body {
    @apply bg-background text-foreground;
    font-family: 'Inter', system-ui, sans-serif;
    font-feature-settings: 'cv11', 'ss01';
    font-variation-settings: 'opsz' 32;
  }
  
  h1, h2, h3, h4, h5, h6 {
    font-family: 'Poppins', system-ui, sans-serif;
    @apply font-semibold text-brand-navy;
  }
  
  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }
  
  /* Remove default button styles */
  button {
    @apply focus:outline-none focus:ring-2 focus:ring-brand-green focus:ring-offset-2;
  }
  
  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  
  ::-webkit-scrollbar-track {
    @apply bg-gray-100;
  }
  
  ::-webkit-scrollbar-thumb {
    @apply bg-gray-300 rounded-full;
  }
  
  ::-webkit-scrollbar-thumb:hover {
    @apply bg-gray-400;
  }
}

@layer components {
  /* BetEA Button Styles */
  .btn {
    @apply inline-flex items-center justify-center rounded-md font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none;
  }
  
  .btn-primary {
    @apply bg-brand-green text-white hover:bg-brand-green/90 focus:ring-brand-green;
  }
  
  .btn-secondary {
    @apply bg-white text-brand-green border-2 border-brand-green hover:bg-brand-green/10 focus:ring-brand-green;
  }
  
  .btn-accent {
    @apply bg-brand-gold text-brand-navy hover:bg-brand-gold/90 focus:ring-brand-gold;
  }
  
  .btn-sm {
    @apply px-3 py-1.5 text-sm;
  }
  
  .btn-md {
    @apply px-4 py-2 text-base;
  }
  
  .btn-lg {
    @apply px-6 py-3 text-lg;
  }
  
  /* BetEA Card Styles */
  .card {
    @apply bg-white rounded-xl border border-gray-200 shadow-card p-4;
  }
  
  .card-hover {
    @apply transition-shadow hover:shadow-md;
  }
  
  /* Odds Display */
  .odds-button {
    @apply bg-gray-100 text-brand-navy font-bold rounded-md px-3 py-2 border-2 border-transparent transition-all hover:border-brand-gold cursor-pointer;
  }
  
  .odds-button-active {
    @apply bg-brand-green/10 border-brand-green text-brand-green;
  }
  
  .odds-button-disabled {
    @apply opacity-50 cursor-not-allowed hover:border-transparent;
  }
  
  /* Bet Slip */
  .betslip {
    @apply fixed bottom-0 right-0 bg-white shadow-betslip rounded-t-xl border-t-4 border-brand-green z-betslip;
  }
  
  /* Balance Display */
  .balance {
    @apply font-mono font-semibold text-brand-green;
  }
  
  /* Status Badges */
  .badge {
    @apply inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium;
  }
  
  .badge-success {
    @apply bg-success/10 text-success;
  }
  
  .badge-warning {
    @apply bg-warning/10 text-warning;
  }
  
  .badge-error {
    @apply bg-error/10 text-error;
  }
  
  .badge-info {
    @apply bg-info/10 text-info;
  }
  
  .badge-pending {
    @apply bg-gray-100 text-gray-600;
  }
  
  /* Input Styles */
  .input {
    @apply w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-green focus:border-transparent;
  }
  
  /* Loading Spinner */
  .spinner {
    @apply animate-spin rounded-full border-2 border-gray-300 border-t-brand-green;
  }
  
  /* Gradient Backgrounds */
  .bg-gradient-green {
    background: linear-gradient(135deg, #00A651 0%, #008A43 100%);
  }
  
  .bg-gradient-gold {
    background: linear-gradient(135deg, #FFB81C 0%, #E6A500 100%);
  }
  
  .bg-gradient-hero {
    background: linear-gradient(135deg, #00A651 0%, #006732 100%);
  }
}

@layer utilities {
  /* Text Utilities */
  .text-balance {
    text-wrap: balance;
  }
  
  /* Touch Target (minimum 44x44px for mobile) */
  .touch-target {
    @apply min-h-[44px] min-w-[44px];
  }
  
  /* Safe Area (for mobile notches) */
  .safe-top {
    padding-top: env(safe-area-inset-top);
  }
  
  .safe-bottom {
    padding-bottom: env(safe-area-inset-bottom);
  }
  
  /* Truncate with tooltip */
  .truncate-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .truncate-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* Glass morphism effect */
  .glass {
    @apply bg-white/80 backdrop-blur-md;
  }
  
  /* Shimmer loading effect */
  .shimmer {
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }
  
  @keyframes shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }
}

/* Print Styles */
@media print {
  .no-print {
    display: none !important;
  }
}

/* Accessibility */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Focus visible for keyboard navigation */
.focus-visible:focus {
  @apply outline-none ring-2 ring-brand-green ring-offset-2;
}

/* High contrast mode support */
@media (prefers-contrast: high) {
  .btn-primary {
    @apply border-2 border-black;
  }
}
